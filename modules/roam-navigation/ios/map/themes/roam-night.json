{
  "version": 8,
  "name": "ROAM Night",
  "glyphs": "mapbox://fonts/mapbox/{fontstack}/{range}.pbf",
  "sources": {
    "roam-streets": {
      "type": "vector",
      "url": "mapbox://mapbox.mapbox-streets-v8"
    }
  },
  "layers": [
    {
      "id": "ground",
      "type": "background",
      "paint": {
        "background-color": "#141617"
      }
    },
    {
      "id": "land",
      "type": "fill",
      "source": "roam-streets",
      "source-layer": "landuse",
      "paint": {
        "fill-color": "#1c1e1c",
        "fill-opacity": 0.6
      }
    },
    {
      "id": "parks",
      "type": "fill",
      "source": "roam-streets",
      "source-layer": "landuse",
      "filter": [
        "match",
        [
          "get",
          "class"
        ],
        [
          "park",
          "wood",
          "national_park",
          "golf_course"
        ],
        true,
        false
      ],
      "paint": {
        "fill-color": "#202a24",
        "fill-opacity": 0.8
      }
    },
    {
      "id": "water",
