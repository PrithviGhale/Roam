# Copy to .env. V0.4 requires the Worker for Gemini + Google REST.
# For iPhone local development use your computer's LAN IP, not localhost.
EXPO_PUBLIC_ROAM_API_URL=
# Optional local / required published prototype gate; PUBLIC, not user auth.
EXPO_PUBLIC_ROAM_ACCESS_TOKEN=
# No general Google REST or Gemini credential belongs in this file.
# Optional separate native map keys; used only when compiling a native build.
# Enable Maps SDK for iOS / Android and restrict each key to that native app.
EXPO_PUBLIC_GOOGLE_MAPS_IOS_KEY=
EXPO_PUBLIC_GOOGLE_MAPS_ANDROID_KEY=
# Legacy adapter header; no server REST key is exposed.
# For a development build set this to its configured iOS bundle identifier.
EXPO_PUBLIC_GOOGLE_IOS_BUNDLE_IDENTIFIER=com.prithvighale.roam
# EXPO_PUBLIC values are visible in the app bundle. Never put private keys here.
# Server secrets go ONLY in ignored server/.dev.vars or Worker secrets.

# Personal project: keep Google Navigation disabled. See docs/v07-navigation.md.
ROAM_ENABLE_NAVIGATION=false

# Mapbox public runtime token (included in the iOS binary). Never use a sk. token here.
EXPO_PUBLIC_MAPBOX_ACCESS_TOKEN=
# Optional Downloads:Read secret, EAS build environment only; never EXPO_PUBLIC.
# Stable Mapbox 3.32.0 binary downloads do not currently require it.
MAPBOX_DOWNLOADS_TOKEN=
