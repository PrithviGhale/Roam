{
  "name": "roam-server",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --ip 0.0.0.0 --port 8787",
    "types": "wrangler types --include-runtime false",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "check": "npm run typecheck && npm test",
    "build": "wrangler deploy --dry-run --outdir build",
    "deploy": "wrangler deploy"
  },
  "dependencies": {
    "@google/genai": "^2.27.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261006.1",
    "@types/node": "^26.6.4",
    "tsx": "^4.23.15",
    "typescript": "~5.9.2",
    "wrangler": "^4.147.0"
  }
}
