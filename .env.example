# Copy to .env. Minimum for real Places + Routes (public prototype REST key).
# Enable Places API (New) and Routes API; restrict APIs and set quotas.
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=
# Optional separate native map keys; used only when compiling a native build.
# Enable Maps SDK for iOS / Android and restrict each key to that native app.
EXPO_PUBLIC_GOOGLE_MAPS_IOS_KEY=
EXPO_PUBLIC_GOOGLE_MAPS_ANDROID_KEY=
# REST request header. Expo Go uses host.exp.Exponent.
# For a development build set this to its configured iOS bundle identifier.
EXPO_PUBLIC_GOOGLE_IOS_BUNDLE_IDENTIFIER=host.exp.Exponent
# Optional replacement for direct REST calls, only if YOU provide the backend
# described in README. This milestone does not deploy or implement a backend.
EXPO_PUBLIC_ROAM_API_URL=
# EXPO_PUBLIC values are visible in the app bundle. Never put private keys here.
