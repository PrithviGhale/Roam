{
  "cli": {
    "appVersionSource": "local"
  },
  "build": {
    "development-simulator": {
      "extends": "development",
      "ios": { "simulator": true }
    },
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "environment": "development",
      "env": {
        "ROAM_ENABLE_NAVIGATION": "false"
      }
    },
    "preview": {
      "distribution": "internal",
      "env": {
        "ROAM_ENABLE_NAVIGATION": "false"
      }
    }
  }
}
