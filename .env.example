# No credentials are needed for V0.1 on iPhone in Expo Go (Apple Maps).
# Reserved for a later Google Maps development build. Restrict by app ID.
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=
# Future backend URL. Gemini secrets must live on that server, not in EXPO_PUBLIC_*.
EXPO_PUBLIC_ROAM_API_URL=
# Never put a private Gemini key into an Expo public environment variable.
# Server-side only, for the future backend:
GEMINI_API_KEY=
